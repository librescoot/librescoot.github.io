source "https://rubygems.org"

# Pinned here rather than through the github-pages gem. That gem forces safe
# mode and a random plugins_dir, which disables _plugins outright, and it
# injects a theme and a dozen plugins this site does not use. Its kramdown and
# future-dated-publishing defaults are spelled out in _config.yml instead.
gem "jekyll", "3.10.0"
gem "kramdown", "2.4.0"
gem "kramdown-parser-gfm", "1.1.0"
gem "rouge", "3.30.0"

group :jekyll_plugins do
  gem "jekyll-polyglot", "1.5.1"
  gem "jekyll-redirect-from", "0.16.0"
end